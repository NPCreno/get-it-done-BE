{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "modulePaths": ["<rootDir>"],
  "testRegex": ".*\\.int-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/test/tsconfig.int.json" }]
  },
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/test/jest-global-tz.ts",
  "testTimeout": 30000
}
