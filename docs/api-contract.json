{
  "version": 1,
  "taskPriorities": [
    "Low",
    "Medium",
    "High"
  ],
  "taskStatuses": [
    "Pending",
    "Complete",
    "Overdue"
  ],
  "newTaskStatuses": [
    "Pending",
    "Complete"
  ],
  "repeatEvery": [
    "Day",
    "Week",
    "Month"
  ],
  "weekdays": [
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
    "Saturday",
    "Sunday"
  ],
  "themes": [
    "light",
    "dark"
  ],
  "booleanStrings": [
    "true",
    "false"
  ],
  "notificationTypes": [
    "achievement",
    "milestone",
    "streak",
    "levelUp",
    "reward",
    "taskDue"
  ],
  "limits": {
    "fullnameMin": 3,
    "fullnameMax": 50,
    "usernameMin": 3,
    "usernameMax": 20,
    "passwordMin": 6,
    "passwordMax": 20,
    "titleMin": 2,
    "titleMax": 100,
    "descriptionMax": 500,
    "colorLabelMax": 50,
    "notificationsPageMax": 100,
    "chatMessageMax": 2000,
    "chatMessagesPageMax": 50,
    "chatMembersMax": 20,
    "tokenNameMax": 60
  },
  "patterns": {
    "username": "^[A-Za-z0-9_]+$",
    "password": "[0-9]"
  },
  "routes": {
    "taskStatus": "/tasks/update-task-status/:task_id/status/:status",
    "subTaskStatus": "/tasks/update-subtask-status/:taskSubInstance_id/status/:status",
    "notificationsList": "/notifications",
    "notificationRead": "/notifications/:notif_id/read",
    "notificationsReadAll": "/notifications/read-all",
    "chatMembersList": "/chat/projects/:project_id/members",
    "chatMemberAdd": "/chat/projects/:project_id/members",
    "chatMemberRemove": "/chat/projects/:project_id/members/:user_id",
    "chatSharedProjects": "/chat/shared-projects",
    "chatMessagesList": "/chat/projects/:project_id/messages",
    "chatMessageSend": "/chat/projects/:project_id/messages",
    "chatMessageDelete": "/chat/projects/:project_id/messages/:id",
    "chatUnread": "/chat/unread",
    "chatMarkRead": "/chat/projects/:project_id/read",
    "tokensList": "/tokens",
    "tokenCreate": "/tokens",
    "tokenRevoke": "/tokens/:id",
    "oauthAuthorizeCheck": "/oauth/authorize/check",
    "oauthAuthorize": "/oauth/authorize",
    "oauthGrantsList": "/oauth/grants",
    "oauthGrantRevoke": "/oauth/grants/:id"
  },
  "projectColors": [
    {
      "label": "Lavender",
      "hex": "#E6E6FA"
    },
    {
      "label": "Mint",
      "hex": "#B5EAD7"
    },
    {
      "label": "Peach",
      "hex": "#FFDAB9"
    },
    {
      "label": "Sky",
      "hex": "#A0D8EF"
    },
    {
      "label": "Lemon",
      "hex": "#FFFACD"
    },
    {
      "label": "Rose",
      "hex": "#FADADD"
    },
    {
      "label": "Mauve",
      "hex": "#E0B0FF"
    },
    {
      "label": "Baby Blue",
      "hex": "#BDE0FE"
    },
    {
      "label": "Coral",
      "hex": "#FFB5A7"
    },
    {
      "label": "Seafoam",
      "hex": "#C3FBD8"
    }
  ],
  "tokens": {
    "prefix": "gid_pat_",
    "expiresInDays": [
      30,
      90,
      365
    ],
    "defaultExpiresInDays": 90,
    "maxActive": 10,
    "createsPerHour": 10,
    "statuses": [
      "active",
      "expired",
      "revoked"
    ],
    "mcpPath": "/mcp",
    "fields": {
      "token": [
        "id",
        "name",
        "prefix",
        "created_at",
        "last_used_at",
        "expires_at",
        "revoked_at",
        "status"
      ],
      "createdToken": [
        "id",
        "name",
        "prefix",
        "created_at",
        "last_used_at",
        "expires_at",
        "revoked_at",
        "status",
        "token"
      ]
    }
  },
  "oauth": {
    "authorizePath": "/oauth/authorize",
    "scopes": [
      "mcp",
      "offline_access"
    ],
    "defaultScope": "mcp",
    "accessTokenPrefix": "gid_oat_",
    "refreshTokenPrefix": "gid_ort_",
    "clientIdPrefix": "gid_cli_",
    "accessTokenSeconds": 3600,
    "refreshTokenDays": 30,
    "grantMaxDays": 180,
    "codeSeconds": 60,
    "refreshRetryGraceSeconds": 60,
    "redirectUrisMax": 5,
    "clientNameMax": 100,
    "defaultClientName": "Unnamed app",
    "registersPerHour": 20,
    "tokenRequestsPerMinute": 60,
    "authorizePerMinute": 30,
    "decisions": [
      "allow",
      "deny"
    ],
    "checkOutcomes": [
      "ok",
      "redirect",
      "fatal"
    ],
    "authorizeParams": [
      "response_type",
      "client_id",
      "redirect_uri",
      "code_challenge",
      "code_challenge_method",
      "scope",
      "state",
      "resource"
    ],
    "fields": {
      "authorizeCheck": [
        "outcome",
        "client_name",
        "redirect_host",
        "loopback_only",
        "scopes"
      ],
      "authorizeCheckRedirect": [
        "outcome",
        "error",
        "redirect_to"
      ],
      "authorizeCheckFatal": [
        "outcome",
        "error"
      ],
      "authorizeDecision": [
        "redirect_to"
      ],
      "authorizeError": [
        "statusCode",
        "error",
        "message",
        "fatal"
      ],
      "grant": [
        "id",
        "client_name",
        "redirect_host",
        "created_at",
        "last_used_at"
      ]
    }
  },
  "chat": {
    "wsPath": "/chat/ws",
    "authTimeoutMs": 5000,
    "closeCodes": {
      "unauthorized": 4401
    },
    "messagesPerMinute": 30,
    "maxRoomsPerSocket": 50,
    "clientFrames": [
      "auth",
      "join",
      "leave"
    ],
    "serverEvents": [
      "ready",
      "joined",
      "left",
      "removed",
      "message.created",
      "message.deleted",
      "error"
    ],
    "errorCodes": [
      "NOT_FOUND",
      "BAD_FRAME",
      "TOO_MANY_ROOMS"
    ],
    "unreadCap": 100,
    "sseEventType": "chat",
    "fields": {
      "member": [
        "user_id",
        "username",
        "fullname"
      ],
      "members": [
        "owner",
        "members"
      ],
      "sharedProject": [
        "project_id",
        "title",
        "color",
        "owner_username"
      ],
      "message": [
        "id",
        "project_id",
        "user_id",
        "username",
        "body",
        "created_at"
      ],
      "messagesPage": [
        "items",
        "next_cursor"
      ],
      "memberRemoved": [
        "project_id",
        "user_id"
      ],
      "messageDeleted": [
        "id",
        "project_id"
      ],
      "unread": [
        "items",
        "total"
      ],
      "unreadItem": [
        "project_id",
        "unread_count"
      ],
      "readPoint": [
        "project_id",
        "last_read_at"
      ],
      "unreadEvent": [
        "project_id"
      ]
    }
  }
}
