{
  "version": 1,
  "taskPriorities": [
    "Low",
    "Medium",
    "High"
  ],
  "taskStatuses": [
    "Pending",
    "Complete",
    "Overdue"
  ],
  "newTaskStatuses": [
    "Pending",
    "Complete"
  ],
  "repeatEvery": [
    "Day",
    "Week",
    "Month"
  ],
  "weekdays": [
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
    "Saturday",
    "Sunday"
  ],
  "themes": [
    "light",
    "dark"
  ],
  "booleanStrings": [
    "true",
    "false"
  ],
  "limits": {
    "fullnameMin": 3,
    "fullnameMax": 50,
    "usernameMin": 3,
