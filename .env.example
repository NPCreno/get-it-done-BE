# --- Local Postgres (docker compose) ---
POSTGRES_DB=getitdone
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev
POSTGRES_PORT=5433

# --- Runtime mode ---
# Local: leave unset (defaults to development). On Railway it MUST be set to production.
# Production-only rules: FRONTEND_URL required (not local), DATABASE_SYNCHRONIZE must not be true.
# NODE_ENV=development

# --- App connection ---
# Required. postgres:// or postgresql:// with a host.
DATABASE_URL=postgresql://postgres:dev@localhost:5433/getitdone
# Never enable this in staging or production; use migrations there.
DATABASE_SYNCHRONIZE=true

# --- JWT ---
# JWT_SECRET, JWT_REFRESH_SECRET, JWT_ACCESS_EXPIRATION are required.
# Expiries need a unit: 15m, 1h, 3600s, 7d. A bare number is milliseconds (3600 = 3.6 s).
# In production use secrets of 32+ characters, different from each other.
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
# Lifetime when Remember Me is off
JWT_REFRESH_EXPIRATION_SHORT=1d
# Replay window for a just-rotated refresh token (seconds)
REFRESH_REUSE_GRACE_SECONDS=30
# Shared with the FE server (never NEXT_PUBLIC_). Attests the BFF-forwarded client IP.
# Generate with: openssl rand -base64 32
INTERNAL_API_SECRET=

# --- App ---
# Origin only (no path or trailing slash). Required in production; local addresses are rejected there.
FRONTEND_URL=http://localhost:3000
PORT=8000
