{
  "notifTypes": [{
    "milestones": [
      {
        "condition": { "every": 10 },
        "type": "milestone",
        "title": "Milestone Achieved!",
        "message": "🏆 You've completed {count} tasks! Keep up the great work!",
        "actionType": "acknowledge",
        "actionTarget": "/achievements",
        "metadata": {
          "completedCount": "{count}",
          "lastTaskId": "{taskId}",
          "milestone": "{milestone}"
        }
      }
    ],
    "achievements": [
      {
        "condition": { "equals": 1 },
        "type": "achievement",
        "title": "First Task Completed!",
        "message": "🎯 Great start! Your productivity journey begins now!",
        "actionType": "acknowledge",
        "actionTarget": "/tasks",
        "metadata": {
          "completedCount": "{count}",
          "lastTaskId": "{taskId}",
          "badge": "first-task"
        }
      },
      {
        "condition": { "equals": 50 },
        "type": "achievement",
        "title": "Half Century!",
        "message": "🔥 50 tasks completed! You're on fire!",
        "actionType": "claim",
        "actionTarget": "/rewards",
        "metadata": {
          "completedCount": "{count}",
          "lastTaskId": "{taskId}",
          "badge": "50-tasks"
        }
      },
      {
        "condition": { "equals": 100 },
        "type": "achievement",
        "title": "Task Master",
        "message": "🏅 100 tasks completed! You're on fire!",
        "actionType": "claim",
        "actionTarget": "/rewards"
      },
      {
        "condition": { "equals": 250 },
        "type": "achievement",
        "title": "Quarter K!",
        "message": "🚀 250 tasks! You're a productivity machine!",
        "actionType": "acknowledge",
        "actionTarget": "/profile/achievements",
        "metadata": {
          "completedCount": "{count}",
          "lastTaskId": "{taskId}",
          "level": "Elite",
          "badge": "quarter-k"
        }
      },
      {
        "condition": { "equals": 500 },
        "type": "achievement",
        "title": "500 Tasks!",
        "message": "🌟 Half a thousand tasks completed! Incredible dedication!",
        "actionType": "claim",
        "actionTarget": "/rewards",
        "metadata": {
          "completedCount": "{count}",
          "lastTaskId": "{taskId}",
          "level": "Master",
          "badge": "500-club"
        }
      },
      {
        "condition": { "equals": 1000 },
        "type": "achievement",
        "title": "Productivity Legend",
        "message": "👑 1000 tasks — legendary dedication!",
        "actionType": "claim",
        "actionTarget": "/rewards"
      }
    ],
    "streaks": [
      {
        "condition": { "equals": 1 },
        "type": "streak",
        "title": "1-Day Streak",
        "message": "✅ You showed up today — that's 1 day in a row! Keep it going! 🔥",
        "actionType": "acknowledge"
      },
      {
        "condition": { "equals": 3 },
        "type": "streak",
        "title": "3-Day Streak",
        "message": "🔥 You're on a roll — 3 days in a row!",
        "actionType": "acknowledge"
      },
      {
        "condition": { "equals": 7 },
        "type": "streak",
        "title": "One Week Strong",
        "message": "💪 7-day streak — keep the momentum alive!",
        "actionType": "acknowledge"
      }
    ],
  
    "levelUps": [
      {
        "condition": { "equals": 1 },
        "type": "levelUp",
        "title": "Level Up!",
        "message": "⬆️ Welcome to Level 1 — The Journey Begins.",
        "actionType": "acknowledge"
      },
      {
        "condition": { "equals": 5 },
        "type": "levelUp",
        "title": "Level 5 Unlocked!",
        "message": "🌟 You're now a Task Pro!",
        "actionType": "acknowledge"
      },
      {
        "condition": { "equals": 100 },
        "type": "levelUp",
        "title": "Century!",
        "message": "💯 Wow! 100 tasks completed! You're unstoppable!",
        "actionType": "acknowledge",
        "actionTarget": "/profile/achievements",
        "metadata": {
          "completedCount": "{count}",
          "lastTaskId": "{taskId}",
          "level": "Pro",
          "badge": "centurion"
        }
      }
    ],
  
    "rewards": [
      {
        "condition": { "equals": 20 },
        "type": "reward",
        "title": "Surprise Reward 🎁",
        "message": "You earned a badge for staying consistent!",
        "actionType": "claim",
        "actionTarget": "/badges"
      }
    ],
  
    "taskDue": [
      {
        "condition": { "equals": 0 },
        "type": "taskDue",
        "title": "Task Reminder",
        "message": "⏰ Task '{taskName}' is due today.",
        "actionType": "complete",
        "actionTarget": "/tasks/{taskId}"
      }
    ]
    }]
  }
  